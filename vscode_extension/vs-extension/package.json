{
  "name": "vs-extension",
  "displayName": "AurIx Security Extension",
  "description": "Real-time vulnerability detection for pasted Python code on save.",
  "version": "0.0.1",
  "publisher": "AurIx",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "AurIx.analyzeWithAI",
        "title": "AurIx: Analyze with AI",
        "category": "AurIx"
      }
    ],

    "keybindings": [
      {
        "command": "AurIx.analyzeWithAI",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus && resourceLangId == python"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "aurix-sidebar",
          "title": "AurIx",
          "icon": "resources/icon.png"
        }
      ]
    },

    "views": {
      "aurix-sidebar": [
        {
          "id": "aurixView",
          "name": "AurIx Analysis"
        }
      ]
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },

  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },

  "dependencies": {
    "axios": "^1.13.2"
  }
}